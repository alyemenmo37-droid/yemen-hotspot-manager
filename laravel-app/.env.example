# ═══════════════════════════════════════
# Application
# ═══════════════════════════════════════
APP_NAME="Yemen Hotspot Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Aden
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# ═══════════════════════════════════════
# Database
# ═══════════════════════════════════════
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yhm_laravel
DB_USERNAME=yhm_user
DB_PASSWORD=alyemenmo370123

# ═══════════════════════════════════════
# Cache
# ═══════════════════════════════════════
CACHE_STORE=database

# ═══════════════════════════════════════
# Session
# ═══════════════════════════════════════
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false  # true مع HTTPS
SESSION_SAME_SITE=lax

# ═══════════════════════════════════════
# MikroTik
# ═══════════════════════════════════════
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=
MIKROTIK_TIMEOUT=5
MIKROTIK_MOCK=true
MIKROTIK_COA_SECRET=coa_secret_2026
MIKROTIK_COA_PORT=3799

# ═══════════════════════════════════════
# Logging
# ═══════════════════════════════════════
LOG_CHANNEL=stack
LOG_LEVEL=error

# ═══════════════════════════════════════
# Queue
# ═══════════════════════════════════════
QUEUE_CONNECTION=database
